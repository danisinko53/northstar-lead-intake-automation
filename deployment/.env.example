# Northstar development/staging configuration example.
# Copy to deployment/.env and replace all placeholder secrets.
# Never commit the populated .env file.

POSTGRES_DB=northstar_crm
POSTGRES_USER=northstar
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY

GENERIC_TIMEZONE=Europe/Budapest
TZ=Europe/Budapest

TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
