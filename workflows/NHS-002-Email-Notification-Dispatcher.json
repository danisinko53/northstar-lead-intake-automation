{
    "name":  "NHS-002 | Email Notification Dispatcher",
    "nodes":  [
                  {
                      "parameters":  {
                                         "rule":  {
                                                      "interval":  [
                                                                       {
                                                                           "field":  "minutes",
                                                                           "minutesInterval":  1
                                                                       }
                                                                   ]
                                                  }
                                     },
                      "type":  "n8n-nodes-base.scheduleTrigger",
                      "typeVersion":  1.4,
                      "position":  [
                                       -224,
                                       0
                                   ],
                      "name":  "Schedule Trigger"
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "\nWITH next_notification AS (\n    SELECT notification_id\n    FROM public.notification_outbox\n    WHERE status IN (\u0027pending\u0027, \u0027failed\u0027)\n      AND next_attempt_at \u003c= CURRENT_TIMESTAMP\n      AND attempt_count \u003c 5\n    ORDER BY next_attempt_at, created_at\n    LIMIT 1\n    FOR UPDATE SKIP LOCKED\n),\nclaimed AS (\n    UPDATE public.notification_outbox AS n\n    SET\n        status = \u0027processing\u0027,\n        attempt_count = n.attempt_count + 1,\n        claimed_at = CURRENT_TIMESTAMP,\n        last_error_code = NULL\n    FROM next_notification AS q\n    WHERE n.notification_id = q.notification_id\n    RETURNING\n        n.notification_id,\n        n.inquiry_id,\n        n.attempt_count\n)\nSELECT\n    c.notification_id,\n    c.inquiry_id,\n    c.attempt_count,\n    i.submission_id,\n    i.service_type,\n    i.assigned_team,\n    i.needs_manual_review,\n    i.status AS inquiry_status,\n    i.zip_code,\n    i.submitted_at\nFROM claimed AS c\nJOIN public.inquiries AS i\n    ON i.inquiry_id = c.inquiry_id;\n",
                                         "options":  {

                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.8,
                      "position":  [
                                       224,
                                       0
                                   ],
                      "name":  "Claim Pending Notification"
                  },
                  {
                      "parameters":  {
                                         "sendTo":  "notifications@example.com",
                                         "subject":  "=\n{{ \u0027Northstar | New \u0027 + $json.service_type + \u0027 inquiry\u0027 }}\n",
                                         "emailType":  "text",
                                         "message":  "=\n{{\n`New customer inquiry received.\n\nService: ${$json.service_type}\nAssigned team: ${$json.assigned_team || \u0027MANUAL REVIEW\u0027}\nZIP code: ${$json.zip_code}\nInquiry ID: ${$json.inquiry_id}\nSubmission ID: ${$json.submission_id}\nStatus: ${$json.inquiry_status}\n\n${$json.needs_manual_review ? \u0027ACTION REQUIRED: Manual team assignment required.\u0027 : \u0027Please review the new inquiry.\u0027}\n\nNorthstar Home Services\nAutomated Notification Dispatcher`\n}}\n",
                                         "options":  {
                                                         "appendAttribution":  false
                                                     }
                                     },
                      "type":  "n8n-nodes-base.gmail",
                      "typeVersion":  2.2,
                      "position":  [
                                       448,
                                       0
                                   ],
                      "name":  "Send Team Assignment Email",
                      "onError":  "continueErrorOutput"
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "\nUPDATE public.notification_outbox\nSET\n    status = \u0027sent\u0027,\n    sent_at = CURRENT_TIMESTAMP,\n    claimed_at = NULL,\n    last_error_code = NULL\nWHERE notification_id = $1::uuid\n  AND status = \u0027processing\u0027\n  AND attempt_count = $2::integer\nRETURNING\n    notification_id,\n    status,\n    sent_at;\n",
                                         "options":  {
                                                         "queryReplacement":  "={{ [   $(\u0027Claim Pending Notification\u0027).first().json.notification_id,   $(\u0027Claim Pending Notification\u0027).first().json.attempt_count ] }}"
                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.8,
                      "position":  [
                                       672,
                                       -96
                                   ],
                      "name":  "Mark Notification Sent"
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "\nUPDATE public.notification_outbox\nSET\n    status = \u0027failed\u0027,\n    claimed_at = NULL,\n    last_error_code = \u0027GMAIL_SEND_FAILED\u0027,\n    next_attempt_at = CURRENT_TIMESTAMP\n        + CASE\n            WHEN attempt_count = 1 THEN INTERVAL \u00271 minute\u0027\n            WHEN attempt_count = 2 THEN INTERVAL \u00275 minutes\u0027\n            WHEN attempt_count = 3 THEN INTERVAL \u002715 minutes\u0027\n            ELSE INTERVAL \u00271 hour\u0027\n          END\nWHERE notification_id = $1::uuid\n  AND status = \u0027processing\u0027\n  AND attempt_count = $2::integer\nRETURNING\n    notification_id,\n    status,\n    attempt_count,\n    next_attempt_at;\n",
                                         "options":  {
                                                         "queryReplacement":  "={{ [   $(\u0027Claim Pending Notification\u0027).first().json.notification_id,   $(\u0027Claim Pending Notification\u0027).first().json.attempt_count ] }}"
                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.8,
                      "position":  [
                                       672,
                                       96
                                   ],
